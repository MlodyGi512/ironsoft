/* IronSoft black-gold minimal theme */
QWidget {
  background-color: #0B0B10;
  color: #E8E8EA;
  font-family: "Segoe UI";
  font-size: 10pt;
}

QGroupBox {
  border: 1px solid #2A2A33;
  border-radius: 10px;
  margin-top: 12px;
  padding: 10px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 6px;
  color: #D4AF37;
}

QLineEdit, QSpinBox {
  background-color: #12121A;
  border: 1px solid #2A2A33;
  border-radius: 8px;
  padding: 6px;
}

QLineEdit:focus, QSpinBox:focus {
  border: 1px solid #D4AF37;
}

QPushButton {
  background-color: #12121A;
  border: 1px solid #D4AF37;
  border-radius: 10px;
  padding: 8px 12px;
  color: #F2E6B8;
}

QPushButton:hover {
  background-color: #171726;
}

QPushButton:pressed {
  background-color: #0F0F16;
}

QTextEdit {
  background-color: #0F0F16;
  border: 1px solid #2A2A33;
  border-radius: 10px;
  padding: 8px;
  font-family: "Consolas";
  font-size: 9pt;
}

QLabel#led {
  background-color: #5A1B1B; /* default OFFLINE */
  border: 2px solid #D4AF37;
  border-radius: 8px;
  min-width: 16px;
  min-height: 16px;
  max-width: 16px;
  max-height: 16px;
}
